<Page
    x:Class="AmNative.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel MaxWidth="1120" Padding="32,28" Spacing="16" HorizontalAlignment="Left">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <StackPanel Spacing="4">
                    <TextBlock Text="Listen now" FontSize="32" FontWeight="Bold" />
                    <TextBlock x:Name="StatusText" Text="Your recommendations and listening history. Select multiple catalog items to add them to your library or favorites, or choose tracks and videos for a playlist." Opacity="0.68" TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="ConnectButton" Grid.Column="1" Content="Connect Apple Music" Click="OnConnectClicked" VerticalAlignment="Center" />
                <Button x:Name="RefreshButton" Grid.Column="2" Content="Refresh" Click="OnRefreshClicked" VerticalAlignment="Center" />
            </Grid>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Text="Picked for you" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button
                            x:Name="LoadMoreRecommendationsButton"
                            Grid.Column="1"
                            Content="Load more"
                            Visibility="Collapsed"
                            Click="OnLoadMoreRecommendationsClicked" />
                    </Grid>
                    <ListView
                        x:Name="RecommendationsList"
                        Height="340"
                        SelectionChanged="OnSelectionChanged"
                        ItemTemplate="{StaticResource MusicResourceRowTemplate}"
                        SelectionMode="Extended" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="8">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBlock Text="Recently played" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ComboBox
                            x:Name="RecentlyPlayedTypeBox"
                            Grid.Column="1"
                            MinWidth="120"
                            SelectedIndex="0"
                            AutomationProperties.Name="Recently played type"
                            ToolTipService.ToolTip="Choose the kind of recently played item"
                            SelectionChanged="OnRecentlyPlayedTypeChanged">
                            <ComboBoxItem Content="Tracks" Tag="tracks" />
                            <ComboBoxItem Content="Albums" Tag="albums" />
                            <ComboBoxItem Content="Artists" Tag="artists" />
                            <ComboBoxItem Content="Playlists" Tag="playlists" />
                            <ComboBoxItem Content="Stations" Tag="stations" />
                        </ComboBox>
                        <Button
                            x:Name="LoadMoreRecentlyPlayedButton"
                            Grid.Column="2"
                            Content="Load more"
                            Visibility="Collapsed"
                            Click="OnLoadMoreRecentlyPlayedClicked" />
                    </Grid>
                    <ListView
                        x:Name="RecentlyPlayedList"
                        Height="340"
                        SelectionChanged="OnSelectionChanged"
                        ItemTemplate="{StaticResource MusicResourceRowTemplate}"
                        SelectionMode="Extended" />
                </StackPanel>
            </Grid>
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="Heavy rotation" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button
                        x:Name="LoadMoreHeavyRotationButton"
                        Grid.Column="1"
                        Content="Load more"
                        Visibility="Collapsed"
                        Click="OnLoadMoreHeavyRotationClicked" />
                </Grid>
                <ListView
                    x:Name="HeavyRotationList"
                    Height="280"
                    SelectionChanged="OnSelectionChanged"
                    ItemTemplate="{StaticResource MusicResourceRowTemplate}"
                    SelectionMode="Extended" />
            </StackPanel>
            <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="OpenButton" Content="Open details" IsEnabled="False" Click="OnOpenClicked" />
                    <Button x:Name="OpenAppleMusicButton" Content="Open in Apple Music" IsEnabled="False" Click="OnOpenAppleMusicClicked" />
                    <Button x:Name="PlayButton" Content="Play" IsEnabled="False" Click="OnPlayClicked" />
                    <Button x:Name="QueueButton" Content="Add to queue" IsEnabled="False" Click="OnQueueClicked" />
                    <Button x:Name="AddButton" Content="Add to library" IsEnabled="False" Click="OnAddClicked" />
                    <Button x:Name="PlaylistButton" Content="Add to playlist" IsEnabled="False" Click="OnAddToPlaylistClicked" />
                    <Button x:Name="FavoriteButton" Content="Add to favorites" IsEnabled="False" Click="OnFavoriteClicked" />
                </StackPanel>
            </ScrollViewer>
            <TextBlock x:Name="ActionStatus" Opacity="0.72" />
            <TextBlock Text="Play full songs and music videos with your Apple Music subscription. Preview audio is available when a full track cannot be played." TextWrapping="Wrap" Opacity="0.58" />
        </StackPanel>
    </ScrollViewer>
</Page>
