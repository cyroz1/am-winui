<Page
    x:Class="AmNative.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel MaxWidth="720" Padding="32,28" Spacing="18" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="Apple Music connection" FontSize="30" FontWeight="Bold" />
                <TextBlock Text="Credentials are stored locally with Windows security. REST API requests send only the developer token and Music User Token to api.music.apple.com." TextWrapping="Wrap" Opacity="0.68" />
            </StackPanel>
            <Border Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Appearance" FontWeight="SemiBold" />
                    <TextBlock Text="Follow Windows or choose a fixed theme for AM Native." TextWrapping="Wrap" Opacity="0.72" />
                    <ComboBox x:Name="ThemeBox" Header="App theme" SelectionChanged="OnThemeChanged" HorizontalAlignment="Left" MinWidth="180">
                        <ComboBoxItem Content="Use Windows setting" Tag="Default" />
                        <ComboBoxItem Content="Light" Tag="Light" />
                        <ComboBoxItem Content="Dark" Tag="Dark" />
                    </ComboBox>
                </StackPanel>
            </Border>
            <Border Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Saved connection" FontWeight="SemiBold" />
                    <TextBlock x:Name="DeveloperTokenSummary" TextWrapping="Wrap" />
                    <TextBlock x:Name="UserTokenSummary" TextWrapping="Wrap" />
                    <TextBlock x:Name="WebCookieSummary" TextWrapping="Wrap" />
                    <Button x:Name="ForgetWebCookieButton" Content="Remove saved web cookie" HorizontalAlignment="Left" Click="OnForgetWebCookieClicked" />
                    <TextBlock x:Name="AccessSummary" TextWrapping="Wrap" Opacity="0.72" />
                </StackPanel>
            </Border>
            <TextBlock Text="Developer token" FontWeight="SemiBold" />
            <PasswordBox x:Name="DeveloperTokenBox" PlaceholderText="Apple Music developer token" />
            <TextBlock Text="If a pasted token has an origin claim, it must allow https://appassets.amnative for both Apple Music API requests and MusicKit playback." TextWrapping="Wrap" Opacity="0.7" />
            <Border Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Or sign developer tokens on this device" FontWeight="SemiBold" />
                    <TextBlock Text="Use the Team ID, Key ID, and .p8 private key from your Apple Developer account. AM Native signs REST tokens and an origin-restricted MusicKit token locally, and keeps the private key in Windows Credential Manager." TextWrapping="Wrap" Opacity="0.72" />
                    <TextBox x:Name="DeveloperTeamIdBox" Header="Team ID" PlaceholderText="Apple Developer Team ID" MaxLength="64" />
                    <TextBox x:Name="DeveloperKeyIdBox" Header="Key ID" PlaceholderText="MusicKit key ID" MaxLength="64" />
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button Content="Choose .p8 key file" Click="OnChooseDeveloperKeyClicked" />
                        <TextBlock x:Name="DeveloperKeyStatus" Text="No new key file selected." VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <TextBlock Text="Music User Token" FontWeight="SemiBold" />
            <PasswordBox x:Name="UserTokenBox" PlaceholderText="Optional if supplied in the cookie below" />
            <TextBlock Text="Apple Music web cookie" FontWeight="SemiBold" />
            <PasswordBox x:Name="CookieBox" PlaceholderText="Optional full Cookie header, including media-user-token" />
            <TextBlock Text="Apple Music API requests use a developer token, and library requests also use a Music User Token. Paste a web cookie header to save its Music User Token separately and retain the full cookie in DPAPI-protected local storage. The REST API client never forwards the cookie header. Full-track playback uses Apple's hosted MusicKit on the Web player inside the shared Microsoft Edge WebView2 runtime." TextWrapping="Wrap" Opacity="0.7" />
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Save securely" Click="OnSaveClicked" />
                <Button x:Name="TestConnectionButton" Content="Test saved connection" Click="OnTestConnectionClicked" />
                <Button Content="Forget credentials" Click="OnForgetClicked" />
            </StackPanel>
            <TextBlock x:Name="StatusText" Text="Credentials have not been saved." TextWrapping="Wrap" />
            <Border Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Playback" FontWeight="SemiBold" />
                    <TextBlock x:Name="MusicKitPlaybackSummary" TextWrapping="Wrap" Opacity="0.72" />
                    <Button x:Name="AuthorizeMusicKitButton" Content="Authorize Apple Music playback" HorizontalAlignment="Left" Click="OnAuthorizeMusicKitClicked" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
