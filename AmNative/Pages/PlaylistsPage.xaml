<Page
    x:Class="AmNative.Pages.PlaylistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="32,28" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="16">
        <StackPanel Spacing="4">
            <TextBlock Text="Playlists" FontSize="30" FontWeight="Bold" />
            <TextBlock Text="Organize folders and playlists. Select tracks with Ctrl or Shift to play or copy them, create a playlist with selected songs or videos, or add them to an existing playlist." Opacity="0.68" />
        </StackPanel>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
            <TextBox x:Name="PlaylistNameBox" PlaceholderText="New playlist or folder name" />
            <Button x:Name="CreatePlaylistButton" Grid.Column="1" Content="Create playlist" Click="OnCreateClicked" />
            <Button x:Name="CreateFolderButton" Grid.Column="2" Content="Create folder" Click="OnCreateFolderClicked" />
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBox x:Name="PlaylistDescriptionBox" PlaceholderText="Playlist description (optional)" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" MaxLength="1000" />
            <CheckBox x:Name="PublicPlaylistCheckBox" Grid.Column="1" Content="Public playlist" VerticalAlignment="Center" />
        </Grid>
        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
            <Button x:Name="UpFolderButton" Content="Up one folder" Visibility="Collapsed" Click="OnUpFolderClicked" />
            <TextBlock x:Name="CurrentFolderText" Grid.Column="1" Text="Playlist folders" VerticalAlignment="Center" FontWeight="SemiBold" />
            <TextBlock x:Name="StatusText" Grid.Column="2" Text="Connect Apple Music in Settings to load your playlists." Opacity="0.72" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button x:Name="LoadMoreFoldersButton" Grid.Column="3" Content="Load more" Visibility="Collapsed" Click="OnLoadMoreFoldersClicked" />
        </Grid>
        <Grid Grid.Row="4" ColumnDefinitions="*,*" ColumnSpacing="18">
            <StackPanel Spacing="8">
                <TextBlock Text="Folders and playlists" FontWeight="SemiBold" />
                <ListView
                    x:Name="PlaylistList"
                    IsItemClickEnabled="True"
                    ItemClick="OnPlaylistClicked"
                    ItemTemplate="{StaticResource MusicResourceRowTemplate}"
                    SelectionMode="Single" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock x:Name="TracksHeading" Text="Tracks" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button
                        x:Name="LoadMoreTracksButton"
                        Grid.Column="1"
                        Content="Load more"
                        Visibility="Collapsed"
                        Click="OnLoadMoreTracksClicked" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox
                        x:Name="TrackFilterBox"
                        PlaceholderText="Filter loaded tracks"
                        AutomationProperties.Name="Filter loaded playlist tracks"
                        TextChanged="OnTrackFilterChanged" />
                    <ComboBox
                        x:Name="TrackSortBox"
                        Grid.Column="1"
                        MinWidth="148"
                        SelectedIndex="0"
                        AutomationProperties.Name="Sort playlist tracks"
                        SelectionChanged="OnTrackSortChanged">
                        <ComboBoxItem Content="Apple order" Tag="apple" />
                        <ComboBoxItem Content="Title A–Z" Tag="title" />
                        <ComboBoxItem Content="Artist A–Z" Tag="artist" />
                        <ComboBoxItem Content="Album A–Z" Tag="album" />
                        <ComboBoxItem Content="Duration: shortest" Tag="duration-ascending" />
                        <ComboBoxItem Content="Duration: longest" Tag="duration-descending" />
                    </ComboBox>
                </Grid>
                <ListView
                    x:Name="TracksList"
                    ItemTemplate="{StaticResource MusicResourceRowTemplate}"
                    SelectionChanged="OnTrackSelectionChanged"
                    SelectionMode="Extended" />
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="10">
            <TextBlock x:Name="SelectedPlaylistText" VerticalAlignment="Center" Opacity="0.72" />
            <Button x:Name="AddSongButton" Content="Add selected items" IsEnabled="False" Click="OnAddSongClicked" />
            <Button x:Name="PlayTrackButton" Content="Play preview queue" IsEnabled="False" Click="OnPlayTrackClicked" />
            <Button x:Name="QueueTrackButton" Content="Add track to queue" IsEnabled="False" Click="OnQueueTrackClicked" />
        </StackPanel>
    </Grid>
</Page>
