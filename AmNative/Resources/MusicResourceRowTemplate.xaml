<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate x:Key="MusicResourceRowTemplate">
        <Grid Padding="8,7" ColumnDefinitions="52,*,Auto" ColumnSpacing="12">
            <Border Width="48" Height="48" CornerRadius="6" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                <Image Source="{Binding ArtworkSource}" Stretch="UniformToFill" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="8,0,6,0" Text="{Binding KindLabel}" FontSize="11" Opacity="0.58" />
        </Grid>
    </DataTemplate>
</ResourceDictionary>
