<Window
    x:Class="AmNative.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="AM Native">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" RowDefinitions="*,Auto">
        <NavigationView
            x:Name="RootNavigation"
            Grid.Row="0"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="LeftCompact"
            SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Listen now" Tag="Home">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Search" Tag="Search">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Find" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Library" Tag="Library">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Library" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Replay" Tag="Replay">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Play" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Playlists" Tag="Playlists">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="List" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem Content="Settings" Tag="Settings">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <Border Grid.Row="1" Padding="16,10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto" VerticalAlignment="Center" ColumnSpacing="8">
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="44" Height="44" CornerRadius="6" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                        <Grid>
                            <Image
                                x:Name="NowPlayingArtwork"
                                Stretch="UniformToFill"
                                Visibility="Collapsed"
                                ImageFailed="OnNowPlayingArtworkFailed"
                                AutomationProperties.Name="Current track artwork" />
                            <TextBlock
                                x:Name="NowPlayingArtworkPlaceholder"
                                Text="♫"
                                FontSize="20"
                                Opacity="0.55"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw" />
                        </Grid>
                    </Border>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="NowPlayingTitle" Text="Nothing playing" FontWeight="SemiBold" />
                        <TextBlock x:Name="NowPlayingArtist" Text="Apple Music preview player" Opacity="0.68" FontSize="12" />
                    </StackPanel>
                </StackPanel>
                <Button x:Name="PreviousTrackButton" Grid.Row="0" Grid.Column="1" Content="Previous" IsEnabled="False" Click="OnPreviousTrackClicked" />
                <controls:MediaPlayerElement
                    x:Name="PlaybackElement"
                    Grid.Row="0"
                    Grid.Column="2"
                    Width="1"
                    Height="1"
                    AreTransportControlsEnabled="False"
                    AutoPlay="False"
                    Stretch="Uniform"
                    Opacity="0"
                    IsHitTestVisible="False"
                    IsTabStop="False"
                    AutomationProperties.AccessibilityView="Raw" />
                <Button
                    x:Name="PlayPauseButton"
                    Grid.Row="0"
                    Grid.Column="3"
                    Content="Play"
                    IsEnabled="False"
                    Click="OnPlayPauseClicked"
                    AutomationProperties.Name="Play or pause preview playback" />
                <Button x:Name="NextTrackButton" Grid.Row="0" Grid.Column="4" Content="Next" IsEnabled="False" Click="OnNextTrackClicked" />
                <ToggleButton x:Name="ShuffleButton" Grid.Row="0" Grid.Column="5" Content="Shuffle" IsEnabled="False" Click="OnShuffleClicked" />
                <ToggleButton x:Name="RepeatButton" Grid.Row="0" Grid.Column="6" Content="Repeat" IsEnabled="False" Click="OnRepeatClicked" />
                <Button x:Name="QueueButton" Grid.Row="0" Grid.Column="7" Content="Queue" IsEnabled="False" Click="OnQueueClicked" />
                <Grid Grid.Row="1" Grid.ColumnSpan="8" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,4,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="CurrentTimeText" Text="0:00" FontSize="12" Opacity="0.68" VerticalAlignment="Center" />
                    <Slider
                        x:Name="PlaybackTimeline"
                        Grid.Column="1"
                        Minimum="0"
                        Maximum="1"
                        Value="0"
                        IsEnabled="False"
                        Height="24"
                        AutomationProperties.Name="Playback position"
                        ValueChanged="OnTimelineValueChanged"
                        PointerPressed="OnTimelinePointerPressed"
                        PointerReleased="OnTimelinePointerReleased"
                        PointerCaptureLost="OnTimelinePointerCaptureLost"
                        KeyUp="OnTimelineKeyUp" />
                    <TextBlock x:Name="DurationText" Grid.Column="2" Text="0:00" FontSize="12" Opacity="0.68" VerticalAlignment="Center" />
                    <Slider
                        x:Name="VolumeSlider"
                        Grid.Column="3"
                        Width="120"
                        Minimum="0"
                        Maximum="1"
                        Value="0.5"
                        AutomationProperties.Name="Playback volume"
                        ToolTipService.ToolTip="Volume"
                        ValueChanged="OnVolumeValueChanged" />
                    <Button
                        x:Name="MuteButton"
                        Grid.Column="4"
                        Content="Mute"
                        Click="OnMuteClicked"
                        AutomationProperties.Name="Mute or restore playback volume" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
